# Use an existing opencode server, or omit this and the SDK starts one.
OPENCODE_URL=http://localhost:4096
# Model must be provider/model as listed by: curl http://localhost:4096/config/providers
OPENCODE_MODEL=opencode-go/deepseek-v4-flash
OPENCODE_API_KEY=sk-...
# Keep Parakeet configurable because installs differ.
PARAKEET_CMD=parakeet-mlx
PARAKEET_ARGS=--output-dir {dir} --output-format txt {input}
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=lecture-bot
STUDY_PACK_DIR=./data/study-packs
PORT=3000
